<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>{{ pretitle }} — Recomendaciones · Canal Meteo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg-dark:{{ bg_dark }};
  --bg-mid:{{ bg_mid }};
  --accent:{{ accent }};
  --accent-text:{{ accent_text }};
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{background:#000;font-family:'Outfit',sans-serif;color:#fff;-webkit-font-smoothing:antialiased;overflow:hidden}
html{width:1080px;height:1920px}
body{width:1080px;height:1920px;position:relative}
@media (max-height: 1919px), (max-width: 1079px){
  html,body{width:100vw;height:100vh}
  .contenedor-sismo{transform-origin:top left;transform:scale(calc(min(100vw / 1080, 100vh / 1920)))}
}
.contenedor-sismo{position:relative;width:1080px;height:1920px;overflow:hidden;background:linear-gradient(135deg,var(--bg-dark) 0%,var(--bg-mid) 50%,var(--bg-dark) 100%)}
.contenedor-sismo::before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(45deg,transparent 0,transparent 80px,rgba(255,255,255,.05) 80px,rgba(255,255,255,.05) 160px);pointer-events:none}
.contenedor-sismo::after{content:"";position:absolute;inset:0;background:radial-gradient(circle at 50% 30%,transparent 0%,rgba(0,0,0,.6) 100%);pointer-events:none}
.cm-header{position:absolute;top:0;left:0;right:0;z-index:5;display:flex;flex-direction:column;align-items:center;padding:50px 60px 20px}
.cm-logo-top{height:78px;width:auto;margin-bottom:22px;filter:drop-shadow(0 4px 14px rgba(0,0,0,.55))}
.alert-pretitle{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:24px;color:var(--accent-text);letter-spacing:.22em;text-transform:uppercase;margin-bottom:14px}
.alert-title{font-family:'Outfit',sans-serif;font-weight:900;font-size:96px;line-height:.92;color:#fff;letter-spacing:-.02em;text-align:center;text-shadow:0 6px 24px rgba(0,0,0,.65);text-transform:uppercase}
.divider{position:absolute;top:440px;left:50%;transform:translateX(-50%);width:120px;height:6px;border-radius:999px;background:linear-gradient(90deg,transparent 0%,var(--accent) 50%,transparent 100%);box-shadow:0 0 24px {{ accent_shadow }};z-index:5}
.recs-grand{position:absolute;top:490px;left:60px;right:60px;bottom:120px;z-index:5;display:flex;flex-direction:column;gap:24px}
.rec-item{display:flex;align-items:center;gap:34px;background:rgba(10,22,40,.55);border:2px solid rgba(255,255,255,.14);border-radius:24px;padding:34px 38px;backdrop-filter:blur(20px);box-shadow:0 8px 32px rgba(0,0,0,.35);flex:1}
.rec-emoji{flex:0 0 auto;width:138px;height:138px;background:{{ emoji_bg_grad }};border-radius:30px;display:flex;align-items:center;justify-content:center;font-size:82px;line-height:1;box-shadow:0 8px 24px {{ accent_shadow }},inset 0 2px 0 rgba(255,255,255,.35),inset 0 -3px 0 rgba(0,0,0,.25),0 0 0 2px rgba(255,255,255,.2)}
.rec-text{flex:1;min-width:0;display:flex;flex-direction:column;gap:10px}
.rec-title{font-family:'Outfit',sans-serif;font-weight:800;font-size:52px;color:#fff;line-height:1.08;letter-spacing:-.01em}
.rec-desc{font-family:'Outfit',sans-serif;font-weight:400;font-size:30px;color:rgba(255,255,255,.88);line-height:1.28}
.cm-footer-mini{position:absolute;left:60px;right:60px;bottom:40px;display:flex;justify-content:space-between;align-items:center;z-index:6}
.cm-footer-mini .url{font-family:'Outfit',sans-serif;font-weight:600;font-size:20px;color:rgba(255,255,255,.9)}
.cm-footer-mini .tag{font-family:'JetBrains Mono',monospace;font-weight:600;font-size:14px;color:rgba(255,255,255,.65);letter-spacing:.18em;text-transform:uppercase}
</style>
</head>
<body>
<div class="contenedor-sismo">
  <header class="cm-header">
    <img class="cm-logo-top" src="{{ logo_url }}" alt="Canal Meteo">
    <div class="alert-pretitle">{{ pretitle }}</div>
    <h1 class="alert-title">{{ title_html | safe }}</h1>
  </header>
  <div class="divider"></div>
  <div class="recs-grand">
    {% for r in recs %}
    <div class="rec-item">
      <div class="rec-emoji">{{ r.emoji }}</div>
      <div class="rec-text">
        <div class="rec-title">{{ r.title }}</div>
        <div class="rec-desc">{{ r.desc }}</div>
      </div>
    </div>
    {% endfor %}
  </div>
  <div class="cm-footer-mini">
    <span class="url">canalmeteo.tv</span>
    <span class="tag">Información del NWS</span>
  </div>
</div>
</body>
</html>
