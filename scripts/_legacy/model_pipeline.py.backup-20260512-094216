def process_variable(var_key, var_config, run_dt, fcst_hours, product_config, output_dir, logger, dry_run=False):
    """
    Procesa una variable a través de todos los forecast hours.
    Devuelve dict con frames generados y metadata.
    """
    frames = []
    var_dir = output_dir / var_key
    var_dir.mkdir(parents=True, exist_ok=True)

    # Limpiar PNGs anteriores (rolling)
    for old_png in var_dir.glob('*.png'):
        old_png.unlink()

    # Variables derivadas requieren tratamiento especial
    if var_config.get('derived'):
        return process_derived_variable(
            var_key, var_config, run_dt, fcst_hours,
            product_config, output_dir, logger, dry_run
        )

    # Composite (ej. wind_10m necesita U+V)
    if var_config.get('composite'):
        searches = var_config['composite']
    else:
        searches = [var_config['herbie']]

    for fxx in fcst_hours:
        try:
            # Descargar todas las searches necesarias
            datasets = []
            for search in searches:
                ds = download_grib_subset(
                    run_dt, fxx, search,
                    product_grib=product_config['product_grib'],
                    logger=logger,
                    dry_run=dry_run,
                )
                if ds is None:
                    raise RuntimeError(f'Failed to download {search} for fxx={fxx}')
                datasets.append(ds)

            # Extraer datos
            if var_config.get('composite'):
                # Combinar (ej. U y V → magnitud)
                arrays = [ds[list(ds.data_vars)[0]].values for ds in datasets]
                data = var_config['conv'](*arrays)
                lats = datasets[0]['latitude'].values
                lons = datasets[0]['longitude'].values
            else:
                ds = datasets[0]
                # Tomar primera variable de datos
                data_var = list(ds.data_vars)[0]
                raw = ds[data_var].values
                data = var_config['conv'](raw)
                lats = ds['latitude'].values
                lons = ds['longitude'].values

            # Normalizar lons a -180..180
            lons = np.where(lons > 180, lons - 360, lons)

            # Renderizar
            png_path = var_dir / f'f{fxx:02d}.png'
            if not dry_run:
                render_to_png(data, lats, lons, var_config, png_path)

            frames.append({
                'fxx': fxx,
                'valid_time': (run_dt + timedelta(hours=fxx)).isoformat(),
                'png': f'{var_key}/f{fxx:02d}.png',
            })

            logger.debug(f'  ✓ {var_key} F{fxx:02d}')

        except Exception as e:
            logger.warning(f'  ✗ {var_key} F{fxx:02d}: {e}')
            continue

    return frames


def process_derived_variable(var_key, var_config, run_dt, fcst_hours, product_config, output_dir, logger, dry_run=False):
    """Procesa variables derivadas (apt_2m, ptype) que requieren múltiples descargas."""
    frames = []
    var_dir = output_dir / var_key
    var_dir.mkdir(parents=True, exist_ok=True)
    for old_png in var_dir.glob('*.png'):
        old_png.unlink()

    for fxx in fcst_hours:
        try:
            if var_key == 'apt_2m':
                # Descargar TMP, DPT, U, V de 2m/10m
                t2m_ds = download_grib_subset(run_dt, fxx, 'TMP:2 m above ground',
                                               product_config['product_grib'], logger, dry_run)
                dpt_ds = download_grib_subset(run_dt, fxx, 'DPT:2 m above ground',
                                               product_config['product_grib'], logger, dry_run)
                u_ds = download_grib_subset(run_dt, fxx, 'UGRD:10 m above ground',
                                             product_config['product_grib'], logger, dry_run)
                v_ds = download_grib_subset(run_dt, fxx, 'VGRD:10 m above ground',
                                             product_config['product_grib'], logger, dry_run)
                if any(d is None for d in [t2m_ds, dpt_ds, u_ds, v_ds]):
                    raise RuntimeError('Missing input for apt_2m')

                t2m_c = t2m_ds[list(t2m_ds.data_vars)[0]].values - 273.15
                dpt_c = dpt_ds[list(dpt_ds.data_vars)[0]].values - 273.15
                u = u_ds[list(u_ds.data_vars)[0]].values
                v = v_ds[list(v_ds.data_vars)[0]].values
                wind_mph = np.sqrt(u**2 + v**2) * 2.23694

                data = compute_apparent_temperature(t2m_c, dpt_c, wind_mph)
                lats = t2m_ds['latitude'].values
                lons = t2m_ds['longitude'].values

            elif var_key == 'ptype':
                crain_ds = download_grib_subset(run_dt, fxx, 'CRAIN:surface',
                                                 product_config['product_grib'], logger, dry_run)
                csnow_ds = download_grib_subset(run_dt, fxx, 'CSNOW:surface',
                                                 product_config['product_grib'], logger, dry_run)
                cicep_ds = download_grib_subset(run_dt, fxx, 'CICEP:surface',
                                                 product_config['product_grib'], logger, dry_run)
                cfrzr_ds = download_grib_subset(run_dt, fxx, 'CFRZR:surface',
                                                 product_config['product_grib'], logger, dry_run)
                if any(d is None for d in [crain_ds, csnow_ds, cicep_ds, cfrzr_ds]):
                    raise RuntimeError('Missing input for ptype')

                crain = crain_ds[list(crain_ds.data_vars)[0]].values
                csnow = csnow_ds[list(csnow_ds.data_vars)[0]].values
                cicep = cicep_ds[list(cicep_ds.data_vars)[0]].values
                cfrzr = cfrzr_ds[list(cfrzr_ds.data_vars)[0]].values

                data = compute_ptype(crain, csnow, cicep, cfrzr)
                lats = crain_ds['latitude'].values
                lons = crain_ds['longitude'].values
            else:
                raise ValueError(f'Variable derivada desconocida: {var_key}')

            lons = np.where(lons > 180, lons - 360, lons)

            png_path = var_dir / f'f{fxx:02d}.png'
            if not dry_run:
                render_to_png(data, lats, lons, var_config, png_path)

            frames.append({
                'fxx': fxx,
                'valid_time': (run_dt + timedelta(hours=fxx)).isoformat(),
                'png': f'{var_key}/f{fxx:02d}.png',
            })
            logger.debug(f'  ✓ {var_key} F{fxx:02d} (derived)')

        except Exception as e:
            logger.warning(f'  ✗ {var_key} F{fxx:02d} (derived): {e}')
            continue

    return frames


def run_pipeline(product_key, run_dt, dry_run=False, logger=None):
    """Ejecuta el pipeline completo para un producto y un run específico."""
    config = PRODUCT_CONFIGS[product_key]
    variables = get_variables_for_product(product_key)

    logger.info('═' * 70)
    logger.info(f'  {config["name"]} — Run {run_dt.strftime("%Y-%m-%d %H:%M UTC")}')
    logger.info('═' * 70)
    logger.info(f'Variables: {len(variables)}, Forecast hours: F{config["forecast_hours"][0]:02d}-F{config["forecast_hours"][-1]:02d}')

    # Directorio de salida local (luego se sincroniza a Spaces)
    output_dir = OUTPUT_BASE / config['output_prefix']
    output_dir.mkdir(parents=True, exist_ok=True)

    manifest = {
        'product': product_key,
        'product_name': config['name'],
        'run_time': run_dt.isoformat(),
        'generated_at': datetime.now(timezone.utc).isoformat().replace('+00:00', 'Z'),
        'forecast_hours': config['forecast_hours'],
        'variables': {},
        'errors': [],
    }

    # Procesar cada variable
    for i, (var_key, var_config) in enumerate(variables.items(), 1):
        logger.info(f'[{i}/{len(variables)}] Procesando {var_key} ({var_config["label"]})')
        try:
            frames = process_variable(
                var_key, var_config, run_dt,
                config['forecast_hours'],
                config, output_dir, logger, dry_run
            )
            manifest['variables'][var_key] = {
                'label': var_config['label'],
                'unit': var_config.get('unit'),
                'vmin': var_config['vmin'],
                'vmax': var_config['vmax'],
                'frames': frames,
            }
            logger.info(f'  → {len(frames)}/{len(config["forecast_hours"])} frames OK')
        except Exception as e:
            err_msg = f'{var_key}: {e}'
            manifest['errors'].append(err_msg)
            logger.error(err_msg)
            logger.error(traceback.format_exc())

    # Guardar manifest
    manifest_path = output_dir / 'manifest.json'
    with open(manifest_path, 'w', encoding='utf-8') as f:
        json.dump(manifest, f, ensure_ascii=False, indent=2)
    logger.info(f'Manifest guardado: {manifest_path}')

    # Resumen de cobertura
    expected = len(config['forecast_hours'])
    coverage = {}
    for var_key, var_data in manifest['variables'].items():
        n = len(var_data['frames'])
        coverage[n] = coverage.get(n, 0) + 1
    logger.info('─' * 70)
    logger.info(f'Cobertura por variable (esperados: {expected} frames):')
    for n_frames, n_vars in sorted(coverage.items(), reverse=True):
        pct = 100.0 * n_frames / expected
        logger.info(f'  {n_vars:2d} variables con {n_frames}/{expected} frames ({pct:.0f}%)')
    if any(n < expected for n in coverage):
        logger.info('  ℹ️  F-hours faltantes son normales si NOAA aún no ha publicado')
        logger.info('     todos los archivos del run. El siguiente run los recupera.')
    logger.info('─' * 70)

    # Sync a Spaces
    if not dry_run:
        logger.info(f'Sincronizando a Spaces: s3://{SPACES_BUCKET}/{config["output_prefix"]}/')
        ok = sync_dir_to_spaces(output_dir, config['output_prefix'], dry_run, logger)
        if ok:
            logger.info('✅ Sync completado')
        else:
            logger.error('❌ Sync falló')

    return manifest


