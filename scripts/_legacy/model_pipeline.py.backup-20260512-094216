# CLI
# ═══════════════════════════════════════════════════════════════════════════

def main():
    parser = argparse.ArgumentParser(
        description='Canal Meteo HRRR pipeline v5.2',
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument('--product', required=True,
                        choices=list(PRODUCT_CONFIGS.keys()),
                        help='Producto a generar')
    parser.add_argument('--once', action='store_true',
                        help='Correr una sola vez y salir (default; sin loops)')
    parser.add_argument('--dry-run', action='store_true',
                        help='No descargar ni renderizar; solo simular')
    parser.add_argument('--date', help='YYYYMMDD del run (override)')
    parser.add_argument('--run-hour', type=int, help='Hora UTC del run (0-23) (override)')
    parser.add_argument('--verbose', '-v', action='store_true',
                        help='Logging DEBUG')

    args = parser.parse_args()

    _import_heavy()  # importar dependencias pesadas solo aquí

    logger = setup_logging(
        args.product,
        level=logging.DEBUG if args.verbose else logging.INFO
    )

    # Validar override
    if (args.date and args.run_hour is None) or (args.run_hour is not None and not args.date):
        logger.error('--date y --run-hour deben usarse juntos')
        sys.exit(1)

    config = PRODUCT_CONFIGS[args.product]

    try:
        with PipelineLock(config['lock_file']):
            run_dt = select_run_datetime(args.product, args.date, args.run_hour)
            logger.info(f'Run seleccionado: {run_dt.isoformat()}')

            # Crear directorios
            HERBIE_CACHE.mkdir(parents=True, exist_ok=True)
            OUTPUT_BASE.mkdir(parents=True, exist_ok=True)

            run_pipeline(args.product, run_dt, dry_run=args.dry_run, logger=logger)

            # Cleanup cache local (mantiene solo último día)
            cleanup_herbie_cache(keep_days=1, logger=logger)

    except RuntimeError as e:
        if 'lock' in str(e).lower():
            logger.warning(f'Skip: {e}')
            sys.exit(0)
        logger.error(str(e))
        sys.exit(1)
    except Exception as e:
        logger.error(f'Pipeline failed: {e}')
        logger.error(traceback.format_exc())
        sys.exit(1)


if __name__ == '__main__':
    main()
