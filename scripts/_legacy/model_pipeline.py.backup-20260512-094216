def select_run_datetime(product_key, override_date=None, override_hour=None):
    """
    Decide qué run de HRRR procesar.

    Para hrrr-18h: el run de la hora previa (espera ~20 min para que esté completo).
    Para hrrr-48h: el run extendido más reciente entre 00/06/12/18 UTC.
    """
    if override_date and override_hour is not None:
        return datetime.strptime(override_date, '%Y%m%d').replace(
            hour=override_hour, tzinfo=timezone.utc
        )

    config = PRODUCT_CONFIGS[product_key]
    eligible = config['eligible_run_hours']
    now = datetime.now(timezone.utc)

    # Margen de 50 min: NOAA tarda ~30-45 min en publicar todos los F-hours
    safe_now = now - timedelta(minutes=50)

    if product_key == 'hrrr-18h':
        # Run de la hora previa
        run = safe_now.replace(minute=0, second=0, microsecond=0)
        return run

    elif product_key == 'hrrr-48h':
        # Buscar el run extendido más reciente que ya haya tenido tiempo de publicarse
        candidate = safe_now.replace(minute=0, second=0, microsecond=0)
        for _ in range(24):  # máx 24h hacia atrás
            if candidate.hour in eligible:
                return candidate
            candidate -= timedelta(hours=1)
        raise RuntimeError('No se encontró run extendido elegible')

    else:
        raise ValueError(f'Producto desconocido: {product_key}')


