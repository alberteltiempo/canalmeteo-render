def download_grib_subset(run_dt, fxx, search_string, product_grib='sfc', logger=None, dry_run=False):
    """
    Descarga subset GRIB usando Herbie (partial download por .idx).

    Args:
        run_dt: datetime del run (UTC)
        fxx: forecast hour (int)
        search_string: regex para .idx (ej. 'TMP:2 m above ground')
        product_grib: 'sfc', 'prs', 'nat', 'subh'
        dry_run: si True, no descarga nada; devuelve None

    Returns:
        xarray.Dataset con la variable, o None si falló o dry-run.
    """
    if dry_run:
        if logger:
            logger.debug(f'[DRY-RUN] skip download fxx={fxx} search={search_string!r}')
        return None
    try:
        H = Herbie(
            run_dt.strftime('%Y-%m-%d %H:%M'),
            model='hrrr',
            product=product_grib,
            fxx=fxx,
            save_dir=HERBIE_CACHE,
            verbose=False,
        )
        # Suprimir excepción específica "No index file was found" que aparece
        # cuando el F-hour aún no está publicado en S3 (no es bug del código)
        ds = H.xarray(search_string, remove_grib=False)
        return ds
    except Exception as e:
        if logger:
            err_str = str(e)
            # F-hour no disponible aún: log más limpio (no warning verbose)
            if 'No index file' in err_str or 'index_as_dataframe' in err_str:
                logger.debug(f'  fxx={fxx} aún no publicado en S3 ({search_string})')
            else:
                logger.warning(f'Herbie download failed for fxx={fxx} search={search_string!r}: {e}')
        return None


