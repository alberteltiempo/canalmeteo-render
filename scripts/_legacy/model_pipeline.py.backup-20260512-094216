def upload_to_spaces(local_path, remote_key, dry_run=False, logger=None):
    """Sube un archivo a DO Spaces vía AWS CLI."""
    cmd = [
        'aws', 's3', 'cp',
        str(local_path),
        f's3://{SPACES_BUCKET}/{remote_key}',
        '--profile', AWS_PROFILE,
        '--endpoint-url', SPACES_ENDPOINT,
        '--acl', 'public-read',
        '--cache-control', 'public, max-age=300',
    ]
    if dry_run:
        if logger:
            logger.info(f'[DRY-RUN] {" ".join(cmd)}')
        return True
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
        if result.returncode != 0:
            if logger:
                logger.error(f'Upload failed: {result.stderr}')
            return False
        return True
    except subprocess.TimeoutExpired:
        if logger:
            logger.error(f'Upload timeout: {remote_key}')
        return False


def sync_dir_to_spaces(local_dir, remote_prefix, dry_run=False, logger=None):
    """Sincroniza un directorio entero a Spaces (más eficiente que cp por archivo)."""
    cmd = [
        'aws', 's3', 'sync',
        str(local_dir),
        f's3://{SPACES_BUCKET}/{remote_prefix}',
        '--profile', AWS_PROFILE,
        '--endpoint-url', SPACES_ENDPOINT,
        '--acl', 'public-read',
        '--cache-control', 'public, max-age=300',
        '--delete',  # remueve archivos que ya no existan localmente (rolling)
    ]
    if dry_run:
        if logger:
            logger.info(f'[DRY-RUN] {" ".join(cmd)}')
        return True
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
        if result.returncode != 0:
            if logger:
                logger.error(f'Sync failed: {result.stderr}')
            return False
        return True
    except subprocess.TimeoutExpired:
        if logger:
            logger.error(f'Sync timeout: {remote_prefix}')
        return False


