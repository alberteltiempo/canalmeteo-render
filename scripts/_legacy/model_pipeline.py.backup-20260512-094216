def compute_apparent_temperature(t2m_c, dpt_c, wind_mph):
    """
    Calcula sensación térmica unificada:
    - Si T <= 10°C y viento >= 4.8 km/h → wind chill
    - Si T >= 27°C y RH >= 40% → heat index
    - Si no → T2m
    """
    rh = _rh_from_dewpoint(t2m_c, dpt_c)
    apt = t2m_c.copy()

    # Wind chill (T en °F, viento en mph para fórmula NWS)
    t_f = t2m_c * 9/5 + 32
    wc_f = 35.74 + 0.6215 * t_f - 35.75 * (wind_mph ** 0.16) + 0.4275 * t_f * (wind_mph ** 0.16)
    wc_c = (wc_f - 32) * 5/9
    mask_wc = (t2m_c <= 10) & (wind_mph >= 3)
    apt = np.where(mask_wc, wc_c, apt)

    # Heat index (formula Steadman/NWS, T en °F, RH en %)
    hi_f = (
        -42.379 + 2.04901523 * t_f + 10.14333127 * rh
        - 0.22475541 * t_f * rh - 6.83783e-3 * t_f**2
        - 5.481717e-2 * rh**2 + 1.22874e-3 * t_f**2 * rh
        + 8.5282e-4 * t_f * rh**2 - 1.99e-6 * t_f**2 * rh**2
    )
    hi_c = (hi_f - 32) * 5/9
    mask_hi = (t2m_c >= 27) & (rh >= 40)
    apt = np.where(mask_hi, hi_c, apt)

    return apt


def _rh_from_dewpoint(t_c, dpt_c):
    """Humedad relativa desde T y Td (Magnus)."""
    a = 17.625
    b = 243.04
    rh = 100 * np.exp((a * dpt_c) / (b + dpt_c)) / np.exp((a * t_c) / (b + t_c))
    return np.clip(rh, 0, 100)


def compute_ptype(crain, csnow, cicep, cfrzr):
    """
    Combina las 4 categóricas de tipo de precipitación en una sola.
    Prioridad: nieve > aguanieve > lluvia helada > lluvia.
    """
    ptype = np.zeros_like(crain, dtype=np.int8)
    ptype = np.where(crain >= 0.5, 1, ptype)
    ptype = np.where(cfrzr >= 0.5, 2, ptype)
    ptype = np.where(cicep >= 0.5, 3, ptype)
    ptype = np.where(csnow >= 0.5, 4, ptype)
    return ptype


