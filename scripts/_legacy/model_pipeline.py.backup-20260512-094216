# LOCK FILE (evita instancias simultáneas)
# ═══════════════════════════════════════════════════════════════════════════

class PipelineLock:
    """Lock fcntl para evitar runs simultáneos del mismo producto."""

    def __init__(self, lock_path):
        self.lock_path = lock_path
        self.fd = None

    def __enter__(self):
        self.fd = open(self.lock_path, 'w')
        try:
            fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            self.fd.write(f'{os.getpid()}\n{datetime.now(timezone.utc).isoformat()}\n')
            self.fd.flush()
            return self
        except BlockingIOError:
            self.fd.close()
            raise RuntimeError(f'Otro proceso ya tiene el lock: {self.lock_path}')

    def __exit__(self, exc_type, exc_val, exc_tb):
        if self.fd:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_UN)
            except Exception:
                pass
            self.fd.close()


