# CLEANUP DEL CACHE LOCAL
# ═══════════════════════════════════════════════════════════════════════════

def cleanup_herbie_cache(keep_days=1, logger=None):
    """
    Borra archivos del cache de Herbie más viejos que keep_days.
    Previene acumulación en /opt/canalmeteo/data/herbie_cache.
    """
    if not HERBIE_CACHE.exists():
        return
    cutoff = datetime.now().timestamp() - (keep_days * 86400)
    removed = 0
    for path in HERBIE_CACHE.rglob('*'):
        if path.is_file() and path.stat().st_mtime < cutoff:
            try:
                path.unlink()
                removed += 1
            except Exception:
                pass
    if logger and removed:
        logger.info(f'Cache cleanup: {removed} archivos antiguos eliminados')


