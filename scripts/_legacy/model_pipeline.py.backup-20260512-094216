def render_to_png(data, lats, lons, var_config, output_path, save_npz=True):
    """
    Renderiza un campo a PNG con la paleta del var_config.
    Usa proyección lat/lon simple (frontend Mapbox proyecta).
    """
    # Aplicar smoothing
    sigma = var_config.get('smooth')
    if sigma is not None:
        data = gaussian_filter(data, sigma=sigma, mode='nearest')

    # Aplicar zoom bilineal si está configurado
    if ZOOM_FACTOR != 1.0:
        data = zoom(data, ZOOM_FACTOR, order=1)
        lats = zoom(lats, ZOOM_FACTOR, order=1)
        lons = zoom(lons, ZOOM_FACTOR, order=1)

    # Figura sin ejes, fondo transparente
    fig = plt.figure(
        figsize=RENDER_FIGSIZE,
        dpi=RENDER_DPI,
        frameon=False,
    )
    ax = fig.add_axes([0, 0, 1, 1])
    ax.set_axis_off()
    ax.set_xlim(CONUS_EXTENT[0], CONUS_EXTENT[1])
    ax.set_ylim(CONUS_EXTENT[2], CONUS_EXTENT[3])

    cmap = var_config['cmap']
    if isinstance(cmap, str):
        cmap = plt.get_cmap(cmap)

    ax.pcolormesh(
        lons, lats, data,
        cmap=cmap,
        vmin=var_config['vmin'],
        vmax=var_config['vmax'],
        shading='auto',
    )

    output_path.parent.mkdir(parents=True, exist_ok=True)
    fig.savefig(output_path, transparent=True, dpi=RENDER_DPI, pad_inches=0)
    plt.close(fig)

    # ─── NPZ_PATCH_APPLIED_v53: guardar valores crudos para interpolate_frames.py ───
    # Esto evita que interpolate_frames.py tenga que decodificar el PNG (lento).
    # El .npz se guarda junto al PNG con el mismo nombre.
    if save_npz:
        try:
            import numpy as _np_npz
            npz_path = output_path.with_suffix('.npz')
            # Guardamos los valores ya procesados (post-smoothing, post-zoom)
            # comprimidos para no inflar el disco
            _np_npz.savez_compressed(npz_path, values=data.astype(_np_npz.float32))
        except Exception as _e:
            # Si falla, no rompemos el pipeline (el PNG ya está guardado)
            import logging as _logging
            _logging.getLogger().warning(f'No se pudo guardar npz {npz_path}: {_e}')


