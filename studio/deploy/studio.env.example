# Copia a studio.env en cada máquina (chmod 600). Las credenciales de Spaces
# pueden venir del perfil boto3 `do-tor1` (~/.aws) en vez de aquí.

# Credenciales DO Spaces (sólo si NO usas el perfil do-tor1):
# DO_SPACES_KEY=
# DO_SPACES_SECRET=

# Overrides opcionales (los valores por defecto ya apuntan a canalmeteo-public/sfo3):
# SPACES_BUCKET=canalmeteo-public
# SPACES_REGION=sfo3
# STUDIO_PREFIX=studio

# Worker (calamarsa):
# STUDIO_WORK_DIR=/opt/canalmeteo/videos
# STUDIO_POLL_INTERVAL=10
